# ───────────────────────────────────────────────────────────────────────────
# Base44 connection
# ───────────────────────────────────────────────────────────────────────────
# Leave BOTH blank to run in DEMO MODE: a localStorage-backed mock that
# implements the exact @base44/sdk interface and is seeded with all 20 lectures.
# Set VITE_BASE44_APP_ID to your real Base44 app id to switch to the live backend
# with ZERO code changes.
VITE_BASE44_APP_ID=

# Require login before the SDK will answer (Base44 createClient option).
# "true" mirrors the production login-gate; demo mode ignores it.
VITE_BASE44_REQUIRES_AUTH=false

# ───────────────────────────────────────────────────────────────────────────
# Secure playback (Appendix B — content protection)
# ───────────────────────────────────────────────────────────────────────────
# Base URL of the Base44 backend function that mints short-lived signed
# playback URLs (e.g. Mux signed JWT). When blank, the player falls back to
# gated embeds (login-gate only — see README "Appendix B").
# Live: deploy functions/playbackToken.example.js and put its URL here.
VITE_PLAYBACK_TOKEN_ENDPOINT=

# Server-side secrets for functions/playbackToken.example.js (set on the Base44
# function, NOT here — shown for reference). From Mux → Settings → Signing Keys.
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=          # base64-encoded RSA private key (PEM)
# PLAYBACK_TTL_SECONDS=120

# Default video provider for newly-created lectures: youtube | mux | vimeo | direct
VITE_DEFAULT_VIDEO_PROVIDER=youtube

# ───────────────────────────────────────────────────────────────────────────
# Translation pipeline (Admin → Translation tab / Foreman Dashboard)
# ───────────────────────────────────────────────────────────────────────────
# Total HeyGen budget for the whole course, used by the dashboard's budget gauge.
VITE_HEYGEN_BUDGET_USD=600

# ───────────────────────────────────────────────────────────────────────────
# Social media promotion — "Follow us" profile links (footer + pages)
# ───────────────────────────────────────────────────────────────────────────
# Set these to Dr. Gavrielov's real profiles. Blank = network home page.
VITE_SOCIAL_PINTEREST=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
# The off-LAN worker POSTs status to a Base44 backend function (see
# functions/translationWebhook.example.js) authenticated with this shared secret.
# This is a SERVER-side secret for the function, not a frontend var — shown here
# only for reference.
# PIPELINE_SHARED_SECRET=change-me
